expr --top-level -- void (*nb_orig_hide)(void*, void*, signed char); void (*nb_orig_move)(void*, void*); void *nb_sel_hide; extern "C" void nb_hide(void *s, void *c, signed char h) { nb_orig_hide(s, c, 1); } extern "C" void nb_move(void *s, void *c) { nb_orig_move(s, c); nb_orig_hide(s, nb_sel_hide, 1); }
expr -l objc -- Class $c = (Class)objc_getClass("_NSThemeWidget"); SEL $sh = @selector(setHidden:); SEL $mv = @selector(viewDidMoveToWindow); struct { const char *a; void *b; const char *c; void *d; } $info; void *$m1 = (void*)class_getInstanceMethod($c, $sh); void *$m2 = (void*)class_getInstanceMethod($c, $mv);
expr void *$fh = (void*)&nb_hide; void *$fm = (void*)&nb_move; int $fresh = (int)dladdr((void*)method_getImplementation($m1), (void*)&$info) != 0; $fresh
expr -l objc -- if ($fresh) { nb_sel_hide = (void*)$sh; nb_orig_hide = (void (*)(void*, void*, signed char))method_getImplementation($m1); nb_orig_move = (void (*)(void*, void*))method_getImplementation($m2); (void)class_replaceMethod($c, $sh, (void (*)(void))$fh, (const char*)method_getTypeEncoding($m1)); (void)class_replaceMethod($c, $mv, (void (*)(void))$fm, (const char*)method_getTypeEncoding($m2)); }
expr -l objc -- id $ws = (id)[(id)[(id)NSClassFromString(@"NSApplication") sharedApplication] windows]; long $n = (long)[$ws count]; for (long i = 0; i < $n; i++) { id w = (id)[$ws objectAtIndex:i]; for (long j = 0; j < 3; j++) (void)[(id)[w standardWindowButton:j] setHidden:NO]; } $n
p (const char*)((int)dladdr((void*)class_getMethodImplementation($c, $sh), (void*)&$info) == 0 ? "nobuttons-ok" : "nobuttons-fail")
detach
